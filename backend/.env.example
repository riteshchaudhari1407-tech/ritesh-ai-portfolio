# LLM Provider Configuration
# Supported options: groq, openai, gemini, nvidia, openrouter
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_or_groq_api_key_here
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins (Comma-separated URLs, e.g. https://ritesh-ai-portfolio.vercel.app,http://localhost:5173 or *)
CORS_ORIGINS=https://ritesh-ai-portfolio.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=https://ritesh-ai-portfolio.vercel.app,http://localhost:5173

# RAG Configuration
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.25

# Rate Limiting
CHAT_RATE_LIMIT_PER_MINUTE=20
